<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<DocumentationFile>bin\$(Configuration)\net10.0\Claims.Api.xml</DocumentationFile>
	<NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Asp.Versioning.Mvc" Version="10.2.1" />
	<PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
	<PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.1" />
	<PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
	<PackageReference Include="MongoDB.Driver" Version="3.6.0" />
	<PackageReference Include="MongoDB.Bson" Version="3.6.0" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\Claims.Domain\Claims.Domain.csproj" />
	<ProjectReference Include="..\Claims.Application\Claims.Application.csproj" />
	<ProjectReference Include="..\Claims.Infrastructure\Claims.Infrastructure.csproj" />
  </ItemGroup>

</Project>